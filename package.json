{
  "name": "software-quizz",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "npx --yes serve .output/public -l 4173",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "sync": "node --env-file-if-exists=.env scripts/sync-notion.ts",
    "test:e2e": "playwright test",
    "questions:plan": "node scripts/plan-questions.ts",
    "questions:apply": "node scripts/apply-questions.ts"
  },
  "dependencies": {
    "nuxt": "^4.6.4",
    "ts-fsrs": "^6.0.0"
  },
  "devDependencies": {
    "@notionhq/client": "^5.31.1",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
